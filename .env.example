# Configuração do GTR desta unidade. Copie para .env e preencha:  cp .env.example .env && chmod 600 .env
# O .env NÃO vai para o Git. Variáveis já definidas no ambiente (systemd, Docker) prevalecem sobre ele.

# ── Banco de dados (obrigatório) ──
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=gtruser
MYSQL_PASSWORD=
MYSQL_DB=gtr
# Só no Docker: senha do root do MariaDB do container
MYSQL_ROOT_PASSWORD=

# ── Sessão ──
# Chave que assina o login (32+ caracteres aleatórios). Em branco: o GTR gera uma e guarda em instance/secret_key.
SECRET_KEY=
# Minutos sem uso até deslogar (os totens não deslogam)
SESSAO_INATIVIDADE_MIN=60
# 1 = cookie só por HTTPS (use onde o GTR só é acessado por HTTPS)
SESSION_COOKIE_SECURE=0

# ── Endereço HTTPS do GTR nesta unidade (ex.: https://10.0.0.10:8443) ──
# O totem de dispensa mostra esse endereço quando a câmera exige conexão segura.
GTR_URL_HTTPS=

# ── Integração Salutem (padrões de instalação nova; depois valem os salvos em Configurações › Integração Salutem) ──
# ex.: SALUTEM_URL=https://10.0.0.20:9004/api/hospitalar  e  SALUTEM_NOME_CERTIFICADO=cliente.sistemasalutem.com.br
SALUTEM_URL=
SALUTEM_NOME_CERTIFICADO=
SALUTEM_EMPRESA_ID=1

# ── Backup (opcional): pasta dos backups. Padrão: ./backups ──
GTR_BACKUP_DIR=
